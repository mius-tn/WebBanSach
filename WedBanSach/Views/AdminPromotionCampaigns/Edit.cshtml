@model WedBanSach.Models.PromotionCampaign
@{
    ViewData["Title"] = "Sửa Chiến Dịch Khuyến Mãi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var books = ViewBag.Books as List<WedBanSach.Models.Book> ?? new List<WedBanSach.Models.Book>();
    var selectedBookIds = ViewBag.SelectedBookIds as List<int> ?? new List<int>();
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Sửa Chiến Dịch Khuyến Mãi</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/Admin/Dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Index")">Khuyến Mãi</a></li>
        <li class="breadcrumb-item active">Sửa</li>
    </ol>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="CampaignID" />
                <input type="hidden" asp-for="CreatedAt" />
                <input type="hidden" asp-for="CreatedBy" />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">Tên Chiến Dịch <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="DiscountType" class="form-label">Loại Giảm Giá <span class="text-danger">*</span></label>
                        <select asp-for="DiscountType" class="form-select">
                            <option value="Percentage">Phần trăm (%)</option>
                            <option value="FixedAmount">Số tiền cố định (đ)</option>
                        </select>
                        <span asp-validation-for="DiscountType" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="DiscountValue" class="form-label">Mức Giảm <span class="text-danger">*</span></label>
                        <input asp-for="DiscountValue" class="form-control" type="number" step="0.01" min="0" required />
                        <span asp-validation-for="DiscountValue" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3">
                        <label asp-for="StartDate" class="form-label">Thời Gian Bắt Đầu <span class="text-danger">*</span></label>
                        <input asp-for="StartDate" class="form-control" type="datetime-local" required />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="EndDate" class="form-label">Thời Gian Kết Thúc <span class="text-danger">*</span></label>
                        <input asp-for="EndDate" class="form-control" type="datetime-local" required />
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="IsActive" class="form-label d-block">&nbsp;</label>
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive">
                            <label class="form-check-label" for="IsActive">Kích Hoạt</label>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Mô Tả</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <div class="card mb-3">
                    <div class="card-header">
                        <i class="fas fa-book me-1"></i>
                        Chọn Sách Áp Dụng
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <input type="text" id="bookSearchInput" class="form-control" placeholder="Tìm kiếm sách theo tên..." />
                        </div>
                        <div style="max-height: 400px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 0.375rem; padding: 0.75rem;">
                            @foreach (var book in books)
                            {
                                var isChecked = selectedBookIds.Contains(book.BookID);
                                <div class="form-check mb-2 book-item">
                                    <input class="form-check-input" type="checkbox" name="bookIds" value="@book.BookID"
                                           id="book_@book.BookID" @(isChecked ? "checked" : "")>
                                    <label class="form-check-label" for="book_@book.BookID">
                                        @book.Title — <span class="text-muted">@book.OriginalPrice.ToString("N0")đ</span>
                                    </label>
                                </div>
                            }
                            @if (!books.Any())
                            {
                                <p class="text-muted mb-0">Không có sách nào.</p>
                            }
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Lưu Chiến Dịch</button>
                    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-x-circle me-1"></i>Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('bookSearchInput').addEventListener('input', function () {
            var filter = this.value.toLowerCase();
            var items = document.querySelectorAll('.book-item');
            items.forEach(function (item) {
                var label = item.querySelector('label').textContent.toLowerCase();
                item.style.display = label.includes(filter) ? '' : 'none';
            });
        });
    </script>
}
