@model WedBanSach.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<!-- BANNER -->
<section class="container mt-4 mb-5">
    <div id="mainBanner" class="carousel slide border-soft overflow-hidden shadow-soft" data-bs-ride="carousel" style="border-radius: 14px;">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#mainBanner" data-bs-slide-to="0" class="active"></button>
            <button type="button" data-bs-target="#mainBanner" data-bs-slide-to="1"></button>
            <button type="button" data-bs-target="#mainBanner" data-bs-slide-to="2"></button>
        </div>
        <div class="carousel-inner">
            <!-- Dummy Banners (Use placehold.co or local images if available) -->
            <div class="carousel-item active">
                <div style="height: 400px; position: relative; overflow: hidden;">
                     <video autoplay muted loop playsinline style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;">
                         <source src="~/video/banner_video.mp4" type="video/mp4">
                     </video>
                     <div class="d-flex align-items-center justify-content-center h-100 position-relative" style="">
                         <div class="text-center text-pink">

                         </div>
                     </div>
                </div>
            </div>  
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#mainBanner" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#mainBanner" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
        </button>
    </div>
</section>




<!-- FLASH SALE SECTION -->
@if (ViewBag.SaleBooks != null && ((List<WedBanSach.Models.Book>)ViewBag.SaleBooks).Any())
{
    <section class="container mb-5 mt-4">
        <div class="p-4" style="background-color: #ff5b5b; border-radius: 14px; box-shadow: 0 4px 15px rgba(255, 91, 91, 0.2);">
            
            <!-- Flash Sale Header (Red background / Integrated style) -->
            <div class="px-2 mb-3 d-flex align-items-center justify-content-between text-white flex-wrap gap-2">
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <span class="flash-sale-logo" style="color: #fff; font-weight: 900; font-style: italic; font-size: 26px; letter-spacing: 0.5px;">
                        <i class="bi bi-lightning-fill text-warning"></i> FLASH SALE
                    </span>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-white-50 small fw-bold text-uppercase">Kết thúc trong</span>
                        <div class="d-flex align-items-center gap-1">
                            <span id="hourBox" class="countdown-box bg-dark text-white">00</span>
                            <span class="fw-bold text-white">:</span>
                            <span id="minuteBox" class="countdown-box bg-dark text-white">00</span>
                            <span class="fw-bold text-white">:</span>
                            <span id="secondBox" class="countdown-box bg-dark text-white">00</span>
                        </div>
                    </div>
                </div>
                <div>
                    <a asp-controller="Books" asp-action="FlashSale" class="text-white text-decoration-none fw-bold small hover-yellow">
                        Xem tất cả <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </div>

            <!-- Flash Sale Products Carousel -->
            <div class="position-relative">
                <button class="btn btn-light shadow rounded-circle position-absolute start-0 top-50 translate-middle-y z-3 carousel-btn-prev" 
                        style="left: -15px !important; width: 40px; height: 40px;" 
                        onclick="scrollCarousel('flash-sale-scroll', -1)">
                    <i class="bi bi-chevron-left"></i>
                </button>

                <div class="d-flex overflow-hidden product-scroll-wrapper" id="flash-sale-scroll" 
                     style="scroll-behavior: smooth; gap: 15px; overflow-x: auto !important; scrollbar-width: none; -ms-overflow-style: none;">
                    
                    @foreach (var book in (List<WedBanSach.Models.Book>)ViewBag.SaleBooks)
                    {
                        var discountPercent = 0;
                        if (book.CurrentPrice < book.OriginalPrice && book.OriginalPrice > 0)
                        {
                            discountPercent = (int)((1 - (book.CurrentPrice / book.OriginalPrice)) * 100);
                        }
                        else if (book.SalePercent.HasValue)
                        {
                            discountPercent = book.SalePercent.Value;
                        }

                        <div class="flex-shrink-0 bg-white p-3 rounded-3 shadow-sm position-relative d-flex flex-column justify-content-between" 
                             style="width: calc(20% - 12px); min-width: 190px; border: 1px solid #f1f3f5;">
                            
                            <!-- Image -->
                            <div class="position-relative overflow-hidden mb-3 text-center" style="height: 180px;">
                                <a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookID" class="d-block h-100">
                                    <img src="@(book.BookImages?.FirstOrDefault(img => img.IsMain)?.ImageUrl ?? "/images/default-book.png")" 
                                         class="h-100 w-auto" style="object-fit: contain; max-width: 100%;" alt="@book.Title">
                                </a>
                                @if (discountPercent > 0)
                                {
                                    <span class="position-absolute top-0 start-0 bg-danger text-white small fw-bold px-2 py-1 rounded-end" style="z-index: 10;">
                                        -@discountPercent%
                                    </span>
                                }
                                <span class="position-absolute bottom-0 end-0 bg-dark text-white px-2 py-0.5 rounded-1" style="font-size: 10px; font-weight: bold; opacity: 0.85;">
                                    Tập @(book.PublishYear ?? 1)
                                </span>
                            </div>

                            <!-- Title & Prices -->
                            <div class="flex-grow-1 d-flex flex-column justify-content-between">
                                <h6 class="book-title-fs mb-2" title="@book.Title" 
                                    style="font-size: 13px; height: 36px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 1.4; font-weight: 600;">
                                    <a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookID" class="text-decoration-none text-dark hover-danger">
                                        @book.Title
                                    </a>
                                </h6>
                                
                                <div class="mb-3">
                                    <div class="d-flex align-items-center gap-1 flex-wrap">
                                        <span class="text-danger fw-bold fs-6">@((book.CurrentPrice).ToString("#,##0")) đ</span>
                                    </div>
                                    @if (book.CurrentPrice < book.OriginalPrice)
                                    {
                                        <span class="text-muted text-decoration-line-through small" style="font-size: 11px;">@book.OriginalPrice.ToString("#,##0") đ</span>
                                    }
                                </div>

                                <!-- Progress Bar (Shopee Style) -->
                                @{
                                    var soldCount = book.SoldStock > 0 ? book.SoldStock : new Random().Next(3, 15);
                                    var maxProgress = book.TotalStock + soldCount;
                                    var progressPercent = maxProgress > 0 ? (int)((double)soldCount / maxProgress * 100) : 0;
                                    if (progressPercent < 15) progressPercent = 15; // Ensure some visual fill
                                }
                                <div class="position-relative w-100 mb-2" style="height: 18px; background-color: #ffd8d8; border-radius: 9px; overflow: hidden;">
                                    <div class="h-100" style="background-color: #ff3b3b; border-radius: 9px; width: @progressPercent%;"></div>
                                    <span class="position-absolute top-0 start-50 translate-middle-x text-white small fw-bold" 
                                          style="font-size: 10px; line-height: 18px; z-index: 5; text-shadow: 0 1px 2px rgba(0,0,0,0.2);">
                                        Đã bán @soldCount
                                    </span>
                                </div>

                                <!-- Add to Cart Button -->
                                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-grid gap-2">
                                    <input type="hidden" name="id" value="@book.BookID" />
                                    @if (book.AvailableStock <= 0)
                                    {
                                        <button type="button" class="btn-flash-cart bg-secondary cursor-not-allowed d-flex align-items-center justify-content-center gap-1" disabled style="background-color: #6c757d !important;">
                                            Hết hàng
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn-flash-cart d-flex align-items-center justify-content-center gap-1">
                                            <i class="bi bi-cart-plus fs-6"></i> Thêm vào giỏ
                                        </button>
                                    }
                                </form>
                            </div>

                        </div>
                    }

                </div>

                <button class="btn btn-light shadow rounded-circle position-absolute end-0 top-50 translate-middle-y z-3 carousel-btn-next" 
                        style="right: -15px !important; width: 40px; height: 40px;" 
                        onclick="scrollCarousel('flash-sale-scroll', 1)">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>

        </div>
    </section>
}

<style>
    .countdown-box {
        background-color: #000;
        color: #fff;
        padding: 2px 6px;
        border-radius: 4px;
        font-weight: bold;
        font-size: 13px;
        min-width: 26px;
        display: inline-block;
        text-align: center;
    }
    .hover-danger:hover {
        color: #ff5b5b !important;
    }
    .icon-circle {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s ease-in-out;
        cursor: pointer;
    }
    .icon-circle:hover {
        transform: translateY(-5px);
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const endDateStr = "@ViewBag.CampaignEndDate";
        const endDate = new Date(endDateStr).getTime();
        
        function updateCountdown() {
            const now = new Date().getTime();
            const distance = endDate - now;
            
            if (distance < 0) {
                document.getElementById("hourBox").innerText = "00";
                document.getElementById("minuteBox").innerText = "00";
                document.getElementById("secondBox").innerText = "00";
                return;
            }
            
            const hours = Math.floor(distance / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);
            
            document.getElementById("hourBox").innerText = String(hours).padStart(2, '0');
            document.getElementById("minuteBox").innerText = String(minutes).padStart(2, '0');
            document.getElementById("secondBox").innerText = String(seconds).padStart(2, '0');
        }
        
        setInterval(updateCountdown, 1000);
        updateCountdown();
    });
</script>

<!-- FEATURED BOOKS -->
<section class="container mb-5">
    <div class="bg-white border-soft p-4 shadow-sm">
        <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-2">
            <h4 class="fw-bold text-pink"><i class="bi bi-star-fill"></i> Sách Nổi Bật</h4>
            <a asp-controller="Books" asp-action="Category" class="btn btn-sm btn-outline-danger rounded-pill px-3">Xem thêm >></a>
        </div>
        
        <div class="position-relative">
             <!-- Carousel Controls -->
            <button class="btn btn-light shadow-sm rounded-circle position-absolute start-0 top-50 translate-middle-y z-1 carousel-btn-prev" style="left: -20px !important; display: none;" onclick="scrollCarousel('featured-scroll', -1)">
                <i class="bi bi-chevron-left"></i>
            </button>

            <div class="d-flex overflow-hidden product-scroll-wrapper" id="featured-scroll" style="scroll-behavior: smooth; gap: 15px; overflow-x: auto !important; scrollbar-width: none; -ms-overflow-style: none;">
                @if (Model.FeaturedBooks != null)
                {
                    @foreach (var book in Model.FeaturedBooks)
                    {
                        <div class="flex-shrink-0" style="width: calc(20% - 12px); min-width: 200px;">
                            <div class="book-card h-100">
                                <!-- Image -->
                                <div class="position-relative overflow-hidden group-hover-img">
                                    <a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookID" class="d-block position-relative">
                                        <img src="@(book.BookImages?.FirstOrDefault(img => img.IsMain)?.ImageUrl ?? "/images/default-book.png")" 
                                             class="book-cover" alt="@book.Title">
                                        @if (book.AvailableStock <= 0)
                                        {
                                            <span class="position-absolute top-0 start-0 bg-secondary text-white small fw-bold px-2 py-1" style="z-index: 10; border-radius: 0 0 4px 0;">
                                                Hết hàng
                                            </span>
                                        }
                                    </a>
                                    @if (book.AvailableStock > 0 && book.CurrentPrice < book.OriginalPrice)
                                    {
                                        var discountPercent = (int)((1 - (book.CurrentPrice / book.OriginalPrice)) * 100);
                                        <span class="position-absolute top-0 start-0 bg-danger text-white small fw-bold px-2 py-1 rounded-end" style="z-index: 10;">
                                            -@discountPercent%
                                        </span>
                                    }
                                </div>

                                <!-- Content -->
                                <div class="book-info">
                                    <h6 class="book-title" title="@book.Title" style="font-size: 14px;">
                                        <a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookID" class="text-decoration-none text-dark">
                                            @book.Title
                                        </a>
                                    </h6>
                                    <p class="book-author text-truncated small mb-2">
                                        @(book.BookAuthors != null && book.BookAuthors.Any() 
                                            ? string.Join(", ", book.BookAuthors.Select(ba => ba.Author.AuthorName)) 
                                            : "Đang cập nhật")
                                    </p>
                                    
                                    <div class="price-box mb-2">
                                        <span class="current-price text-nowrap" style="font-size: 16px;">
                                            @((book.CurrentPrice).ToString("#,##0")) ₫
                                        </span>
                                        @if(book.CurrentPrice < book.OriginalPrice)
                                        {
                                             <span class="original-price text-nowrap" style="font-size: 12px;">@book.OriginalPrice.ToString("#,##0") ₫</span>
                                        }
                                    </div>
                                    
                                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-grid gap-2">
                                        <input type="hidden" name="id" value="@book.BookID" />
                                        @if (book.AvailableStock <= 0)
                                        {
                                            <button type="button" class="btn btn-sm btn-secondary text-white" disabled>
                                                Hết hàng
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-pink">
                                                <i class="bi bi-cart-plus"></i> Thêm
                                            </button>
                                        }
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <button class="btn btn-light shadow-sm rounded-circle position-absolute end-0 top-50 translate-middle-y z-1 carousel-btn-next" style="right: -20px !important;" onclick="scrollCarousel('featured-scroll', 1)">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>
</section>


