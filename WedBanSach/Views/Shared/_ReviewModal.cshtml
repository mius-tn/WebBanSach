<div class="modal fade" id="writeReviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold" id="reviewModalTitle">Viết đánh giá</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="reviewForm" enctype="multipart/form-data">
                    <input type="hidden" name="bookId" id="reviewBookId">
                    
                    <!-- Product Info (Optional, added dynamically via JS) -->
                    <div id="reviewProductInfo" class="mb-3 text-center d-none">
                         <h6 class="fw-bold" id="reviewProductName"></h6>
                    </div>

                    <div class="mb-3 text-center">
                        <label class="form-label d-block fw-bold mb-2">Bạn chấm sản phẩm này bao nhiêu sao?</label>
                        <div class="rating-input d-inline-flex flex-row-reverse gap-2 fs-3 text-secondary pointer-event">
                            <input type="radio" name="rating" value="5" id="r5" class="d-none peer">
                            <label for="r5" class="cursor-pointer text-warning">
                                <i class="bi bi-star star-empty"></i>
                                <i class="bi bi-star-fill star-fill d-none"></i>
                            </label>
                            
                            <input type="radio" name="rating" value="4" id="r4" class="d-none peer">
                            <label for="r4" class="cursor-pointer text-warning">
                                <i class="bi bi-star star-empty"></i>
                                <i class="bi bi-star-fill star-fill d-none"></i>
                            </label>
                            
                            <input type="radio" name="rating" value="3" id="r3" class="d-none peer">
                            <label for="r3" class="cursor-pointer text-warning">
                                <i class="bi bi-star star-empty"></i>
                                <i class="bi bi-star-fill star-fill d-none"></i>
                            </label>
                            
                            <input type="radio" name="rating" value="2" id="r2" class="d-none peer">
                            <label for="r2" class="cursor-pointer text-warning">
                                <i class="bi bi-star star-empty"></i>
                                <i class="bi bi-star-fill star-fill d-none"></i>
                            </label>
                            
                            <input type="radio" name="rating" value="1" id="r1" class="d-none peer">
                            <label for="r1" class="cursor-pointer text-warning">
                                <i class="bi bi-star star-empty"></i>
                                <i class="bi bi-star-fill star-fill d-none"></i>
                            </label>
                        </div>
                        <style>
                            /* Rating Star Logic */
                            .rating-input input:checked ~ label .star-empty,
                            .rating-input input:checked + label .star-empty,
                            .rating-input label:hover .star-empty,
                            .rating-input label:hover ~ label .star-empty {
                                display: none !important;
                            }
                            
                            .rating-input input:checked ~ label .star-fill,
                            .rating-input input:checked + label .star-fill,
                            .rating-input label:hover .star-fill,
                            .rating-input label:hover ~ label .star-fill {
                                display: inline-block !important;
                            }
                        </style>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Hình ảnh (Tùy chọn)</label>
                        <input type="file" class="form-control form-control-sm" name="reviewImage" accept="image/*" onchange="previewReviewImage(this)">
                        <div id="reviewImagePreview" class="mt-2 d-none">
                            <img src="" class="rounded border object-fit-cover" style="height: 100px; width: auto;">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Nhận xét của bạn</label>
                        <textarea class="form-control" name="comment" rows="3" placeholder="Chia sẻ cảm nhận về sản phẩm..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-danger w-100 rounded-pill fw-bold">Gửi đánh giá</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function previewReviewImage(input) {
        const previewContainer = document.getElementById('reviewImagePreview');
        const previewImage = previewContainer.querySelector('img');
        
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                previewImage.src = e.target.result;
                previewContainer.classList.remove('d-none');
            }
            reader.readAsDataURL(input.files[0]);
        } else {
            previewContainer.classList.add('d-none');
            previewImage.src = '';
        }
    }

    // Initialize Review Form Submission Logic (Global)
    document.addEventListener('DOMContentLoaded', function() {
        const reviewForm = document.getElementById('reviewForm');
        if(reviewForm) {
            reviewForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                if (!document.querySelector('input[name="rating"]:checked')) {
                    alert('Vui lòng chọn số sao đánh giá!');
                    return;
                }

                var formData = new FormData(this);

                $.ajax({
                    url: '/Review/SubmitReview', // Ensure this route exists in ReviewController
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(res) {
                        if (res.success) {
                            alert(res.message);
                            location.reload(); 
                        } else {
                            alert(res.message);
                        }
                    },
                    error: function() {
                        alert('Có lỗi xảy ra. Vui lòng thử lại sau.');
                    }
                });
            });
        }
    });

    // Helper to open review modal
    function openReviewModal(bookId, bookTitle = '') {
        const bookIdInput = document.getElementById('reviewBookId');
        if(bookIdInput) bookIdInput.value = bookId;
        
        const form = document.getElementById('reviewForm');
        if(form) form.reset();
        
        const previewEl = document.getElementById('reviewImagePreview');
        if(previewEl) previewEl.classList.add('d-none');
        
        // Add title if needed
        if(bookTitle) {
             const infoDiv = document.getElementById('reviewProductInfo');
             const nameEl = document.getElementById('reviewProductName');
             if(infoDiv && nameEl) {
                 nameEl.textContent = bookTitle;
                 infoDiv.classList.remove('d-none');
             }
        } else {
             const infoDiv = document.getElementById('reviewProductInfo');
             if(infoDiv) infoDiv.classList.add('d-none');
        }

        const modalEl = document.getElementById('writeReviewModal');
        if(modalEl) {
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }
    }
</script>
