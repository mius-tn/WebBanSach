                                    <dl class="p-chara_content__cv">
                                        <dt class="p-chara_content__cv-cap">CV</dt>
                                        <dd class="p-chara_content__cv-text">Ishikawa Kaito</dd>
                                    </dl>
                                    <div class="p-chara_content__info">
                                        <dl class="p-chara_content__data">
