            <path id="badgeTextPath" d="M 50, 50 m -40, 0 a 40,40 0 1,1 80,0 a 40,40 0 1,1 -80,0" fill="none" />
            <text>
                <textPath href="#badgeTextPath" startOffset="0%">
                    Abnormal experiences during adolescence due to sensitivity and instability. Puberty syndrome.
                </textPath>
            </text>
        </svg>
        <div class="p-hero__ticket-badge-inner">
            <img src="https://ao-buta.com/dearfriend/assets/img/ticket/img_movieticket2.jpg" alt="Ticket" class="p-hero__ticket-badge-img">
            <span class="p-hero__ticket-badge-title">記念前売券</span>
            <span class="p-hero__ticket-badge-btn">詳しくはこちら</span>
        </div>
    </a>

    <!-- YouTube Video Modal Container -->
    <div class="video-modal" id="videoModal">
        <div class="video-modal__container">
            <button class="video-modal__close" id="videoModalCloseBtn" type="button">&times;</button>
            <iframe id="videoIframe" src="" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
    </div>

</div>

@section Scripts {
    <!-- Dynamic CDN Library Loading -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-easing/1.4.1/jquery.easing.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <script src="https://unpkg.com/lenis@1.1.9/dist/lenis.min.js"></script>
    
    <script>
        // Initialize Lenis Smooth Scroll
        const lenis = new Lenis({
            duration: 1.2,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            orientation: 'vertical',
            gestureOrientation: 'vertical',
            smoothWheel: true,
            wheelMultiplier: 1,
            touchMultiplier: 2,
            infinite: false
        });

        // Sync Lenis with GSAP ScrollTrigger
        lenis.on('scroll', ScrollTrigger.update);

        function raf(time) {
            lenis.raf(time);
            requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        // Configure GSAP lag smoothing to play nice with smooth scroll
        if (typeof gsap !== 'undefined') {
            gsap.ticker.lagSmoothing(0);
        }

        // Sakura floating particles generator
        (function() {
            var container = document.getElementById('particles');
            if (!container) return;
            
            var petalCount = 25;
            for (var i = 0; i < petalCount; i++) {
                var petal = document.createElement('div');
                petal.className = 'petal';
                
                // Random styling for realistic wind falling
                var size = Math.random() * 8 + 8; // 8px to 16px
                var left = Math.random() * 100;
                var delay = Math.random() * 10;
                var duration = Math.random() * 8 + 8; // 8s to 16s
                
                petal.style.width = size + 'px';
                petal.style.height = size + 'px';
                petal.style.left = left + '%';
                petal.style.animationDelay = delay + 's';
                petal.style.animationDuration = duration + 's';
                
                container.appendChild(petal);
            }
        })();

        // Sidebar navigation scroll behaviors & active state transitions
        (function() {
            // Toggle mobile menu
            var mobileBtn = document.getElementById('mobileMenuBtn');
            var sidebar = document.getElementById('sidebarMenu');
            var toggleBtns = document.querySelectorAll('.js-menu-toggle');
            
            function toggleMenu() {
                if (sidebar) {
                    sidebar.classList.toggle('is-active');
                }
                if (mobileBtn) {
                    mobileBtn.classList.toggle('is-active');
                }
            }
            
            if (mobileBtn) {
                mobileBtn.addEventListener('click', toggleMenu);
            }
            
            toggleBtns.forEach(function(btn) {
                btn.addEventListener('click', toggleMenu);
            });
            
            // Handle closing mobile menu on link clicks
            var menuCloseLinks = document.querySelectorAll('.js-menu-close');
            menuCloseLinks.forEach(function(link) {
                link.addEventListener('click', function() {
                    if (mobileBtn && sidebar) {
                        mobileBtn.classList.remove('is-active');
                        sidebar.classList.remove('is-active');
                    }
                });
            });

            // Smooth scroll implementation for anchor links and buttons using Lenis
            var smoothScrollLinks = document.querySelectorAll('.smooth-scroll-link');
            smoothScrollLinks.forEach(function(link) {
                link.addEventListener('click', function(e) {
                    var targetId = this.getAttribute('href');
                    if (targetId.startsWith('#')) {
                        e.preventDefault();
                        var targetEl = document.querySelector(targetId);
                        if (targetEl) {
                            lenis.scrollTo(targetEl, { offset: -75 });
                        }
                    }
                });
            });

            var smoothScrollBtns = document.querySelectorAll('.smooth-scroll-btn');
            smoothScrollBtns.forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    var targetId = this.getAttribute('data-anchor');
                    if (targetId && targetId.startsWith('#')) {
                        e.preventDefault();
                        var targetEl = document.querySelector(targetId);
                        if (targetEl) {
                            lenis.scrollTo(targetEl, { offset: -75 });
                        }
                    }
                });
            });

            // Pagetop button scroll action
            var pagetopBtn = document.getElementById('pagetopBtn');
            if (pagetopBtn) {
                pagetopBtn.addEventListener('click', function() {
                    lenis.scrollTo(0);
                });
            }

            // Quick ticket floating button scroll action
            var quickTicketBtn = document.getElementById('quickTicketBtn');
            if (quickTicketBtn) {
                quickTicketBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    var ticketEl = document.getElementById('ticket');
                    if (ticketEl) {
                        lenis.scrollTo(ticketEl, { offset: -75 });
                    }
                });
            }
        })();

        // Character showcase tab switcher
        (function() {
            var tabItems = document.querySelectorAll('.p-chara_nav__list-item');
            var contents = document.querySelectorAll('.p-chara_content');
            
            tabItems.forEach(function(item) {
                item.addEventListener('click', function() {
                    // Clear active classes
                    tabItems.forEach(function(el) { el.classList.remove('is-active'); });
                    contents.forEach(function(el) { el.classList.remove('is-active'); });
                    
                    // Add active to current
                    this.classList.add('is-active');
                    var targetId = this.getAttribute('data-chara-target');
                    var contentEl = document.getElementById('chara-' + targetId);
                    if (contentEl) {
                        contentEl.classList.add('is-active');
                    }
                });
            });
        })();

        // YouTube popup video modal player
        (function() {
            var modal = document.getElementById('videoModal');
            var iframe = document.getElementById('videoIframe');
            var closeBtn = document.getElementById('videoModalCloseBtn');
            var triggers = document.querySelectorAll('.p-movie_article__thumb');
            
            triggers.forEach(function(trigger) {
                trigger.addEventListener('click', function() {
                    var youtubeId = this.getAttribute('data-youtube-id');
                    if (youtubeId && modal && iframe) {
                        iframe.src = 'https://www.youtube.com/embed/' + youtubeId + '?autoplay=1';
                        modal.style.display = 'flex';
                    }
                });
            });
            
            function closeModal() {
                if (modal && iframe) {
                    modal.style.display = 'none';
                    iframe.src = '';
                }
            }
            
            if (closeBtn) {
                closeBtn.addEventListener('click', closeModal);
            }
            
            if (modal) {
                modal.addEventListener('click', function(e) {
                    if (e.target === modal) {
                        closeModal();
                    }
                });
            }
        })();

        // Movie Slider Carousel
        (function() {
            var slides = document.querySelectorAll('.p-movie__slide');
            var dots = document.querySelectorAll('.p-movie__dot');
            var activeIndex = 0;
            var timer = null;

            function showSlide(index) {
                if (slides.length === 0) return;
                slides.forEach(function(slide, idx) {
                    if (idx === index) {
                        slide.classList.add('is-active');
                    } else {
                        slide.classList.remove('is-active');
                    }
                });
                dots.forEach(function(dot, idx) {
                    if (idx === index) {
                        dot.classList.add('is-active');
                    } else {
                        dot.classList.remove('is-active');
                    }
                });
                activeIndex = index;
            }

            dots.forEach(function(dot) {
                dot.addEventListener('click', function() {
                    var index = parseInt(this.getAttribute('data-slide'));
                    showSlide(index);
                    resetTimer();
                });
            });

            function startTimer() {
                timer = setInterval(function() {
                    var nextIndex = (activeIndex + 1) % slides.length;
                    showSlide(nextIndex);
                }, 5000);
            }

            function resetTimer() {
                if (timer) {
                    clearInterval(timer);
                    startTimer();
                }
            }

            startTimer();
        })();

        // Prologue character parallax scroll effect
        (function() {
            if (typeof gsap !== "undefined" && typeof ScrollTrigger !== "undefined") {
                gsap.registerPlugin(ScrollTrigger);
                
                // Animating Chara 2 (Mai) upwards on scroll
                gsap.fromTo("#prologueChara2", 
                    { y: 120 }, 
                    {
                        y: -120,
                        ease: "none",
                        scrollTrigger: {
                            trigger: "#prologue",
                            start: "top bottom",
                            end: "bottom top",
                            scrub: 1
                        }
                    }
                );
                
                // Slightly animate Chara 1 (Touko) slower to enhance depth
                gsap.fromTo("#prologueChara1", 
                    { y: -60 }, 
                    {
                        y: 60,
                        ease: "none",
                        scrollTrigger: {
                            trigger: "#prologue",
                            start: "top bottom",
                            end: "bottom top",
                            scrub: 1
                        }
                    }
                );
            }
        })();

        // Parallax scrolling speed modifier for the intro banner image
        (function() {
            var parallaxImg = document.getElementById('introParallaxImg');
            
            window.addEventListener('scroll', function() {
                if (!parallaxImg) return;
                var rect = parallaxImg.parentElement.getBoundingClientRect();
                
                // Only update when in viewport area
                if (rect.top < window.innerHeight && rect.bottom > 0) {
                    var offset = (window.innerHeight - rect.top) * 0.15;
                    parallaxImg.style.transform = 'translateY(' + (offset - 40) + 'px)';
                }
            });
        })();

        // Scroll reveal animation engine
        (function() {
            var revealElements = document.querySelectorAll('.scroll-reveal');
            
            var observerOptions = {
                root: null,
                threshold: 0.1,
                rootMargin: '0px 0px -50px 0px'
            };
            
            var observer = new IntersectionObserver(function(entries, observer) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('in-view');
                        observer.unobserve(entry.target); // Trigger animation once
                    }
                });
            }, observerOptions);
            
                revealElements.forEach(function(el) {
                observer.observe(el);
            });
        })();

        // Add to Cart Modal Success Feedback (Simple ao-buta style)
        (function() {
            var forms = document.querySelectorAll('form[action*="/Cart/AddToCart"]');
            var modal = document.getElementById('cartSuccessModal');
            var btnContinue = document.getElementById('btnContinueShopping');
            var btnContinueOverlay = document.getElementById('btnContinueShoppingOverlay');
            var btnContinueX = document.getElementById('btnContinueShoppingX');
            
            var modalBookImg = document.getElementById('modalBookImg');
            var modalBookTitle = document.getElementById('modalBookTitle');
            var modalBookPrice = document.getElementById('modalBookPrice');
            
            function closeModal() {
                if (modal) {
                    modal.classList.remove('is-active');
                    document.body.style.overflow = ''; // Restore scroll
                }
            }
            
            if (btnContinue) btnContinue.addEventListener('click', closeModal);
            if (btnContinueOverlay) btnContinueOverlay.addEventListener('click', closeModal);
            if (btnContinueX) btnContinueX.addEventListener('click', closeModal);
            
            forms.forEach(function(form) {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    
                    var submitBtn = form.querySelector('button[type="submit"]');
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.style.transform = 'scale(0.95)';
                        submitBtn.style.transition = 'all 0.3s cubic-bezier(0.25, 1, 0.5, 1)';
                        
                        var textSpan = submitBtn.querySelector('.p-ticket_content__btn-text') || submitBtn.querySelector('.p-ticket-combo__btn-text');
                        if (textSpan) {
                            textSpan.textContent = 'ĐANG XỬ LÝ...';
                        }
                        
                        setTimeout(function() {
                            submitBtn.style.transform = 'scale(1)';
                        }, 300);
                    }
                    
                    // Fetch product details from the card UI
                    var card = form.closest('.p-ticket_content') || form.closest('.p-ticket-combo');
                    var bookImgSrc = "";
                    var bookTitle = "Sách Anime";
                    var bookPrice = "";
                    
                    if (card) {
                        var imgEl = card.querySelector('.p-ticket_visual__img img') || card.querySelector('.p-ticket-combo__image');
                        if (imgEl) bookImgSrc = imgEl.src;
                        
                        var titleEl = card.querySelector('.p-ticket_content__title') || card.querySelector('.p-ticket-combo__subtitle');
                        if (titleEl) bookTitle = titleEl.textContent.trim();
                        
                        var priceEl = card.querySelector('.p-ticket_content__data-text.text-danger') || card.querySelector('.p-ticket-combo__data-text.text-danger');
                        if (priceEl) {
                            bookPrice = priceEl.childNodes[0] ? priceEl.childNodes[0].textContent.trim() : priceEl.textContent.trim();
                        }
                    }
                    
                    // Submit AddToCart via AJAX
                    fetch('/Cart/AddToCart?ajax=true', {
                        method: 'POST',
                        body: new FormData(form),
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(function(res) {
                        return res.json();
                    })
                    .then(function(data) {
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            var textSpan = submitBtn.querySelector('.p-ticket_content__btn-text') || submitBtn.querySelector('.p-ticket-combo__btn-text');
                            if (textSpan) {
                                textSpan.textContent = 'ĐẶT MUA SÁCH';
                            }
                        }
                        
                        // Populate modal information
                        if (modalBookImg) modalBookImg.src = bookImgSrc;
                        if (modalBookTitle) modalBookTitle.textContent = bookTitle;
                        if (modalBookPrice) modalBookPrice.textContent = bookPrice;
                        
                        // Update Cart Badge dynamically
                        if (data && data.cartCount !== undefined) {
                            var cartIcon = document.querySelector('.bi-cart3');
                            if (cartIcon) {
                                var badge = cartIcon.parentElement.querySelector('.badge');
                                if (badge) {
                                    badge.textContent = data.cartCount;
                                } else {
                                    var newBadge = document.createElement('span');
                                    newBadge.className = 'position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger';
                                    newBadge.style.fontSize = '10px';
                                    newBadge.textContent = data.cartCount;
                                    cartIcon.parentElement.appendChild(newBadge);
                                }
                            }
                        }
                        
                        // Show toast notification (without blocking scroll)
                        if (modal) {
                            modal.classList.add('is-active');
                            
                            // Auto close after 4 seconds
                            if (window.cartToastTimeout) clearTimeout(window.cartToastTimeout);
                            window.cartToastTimeout = setTimeout(function() {
                                closeModal();
                            }, 4000);
                        }
                    })
                    .catch(function(err) {
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            var textSpan = submitBtn.querySelector('.p-ticket_content__btn-text');
                            if (textSpan) {
                                textSpan.textContent = 'ĐẶT MUA SÁCH';
                            }
                        }
                        console.error('AJAX add to cart failed:', err);
                        form.submit(); // fallback to classic redirect if AJAX fails
                    });
                });
            });

            // Auto-scroll product cards every 3 seconds with CSS snapping
            (function() {
                var container = document.querySelector('.p-ticket__inner');
                if (!container) return;
                
                var intervalTime = 3000;
                var intervalId;
                
                function getCardWidth() {
                    var cards = container.querySelectorAll('.p-ticket_content');
                    if (cards.length < 2) return container.clientWidth;
                    return cards[1].getBoundingClientRect().left - cards[0].getBoundingClientRect().left;
                }
                
                function startAutoScroll() {
                    stopAutoScroll();
                    intervalId = setInterval(function() {
                        var cardWidth = getCardWidth();
                        var maxScrollLeft = container.scrollWidth - container.clientWidth;
                        var currentScroll = container.scrollLeft;
                        
                        // Rounding to next card
                        var nextScroll = Math.ceil(currentScroll / cardWidth) * cardWidth;
                        if (Math.abs(nextScroll - currentScroll) < 10) {
                            nextScroll += cardWidth;
                        }
                        
                        if (currentScroll >= maxScrollLeft - 10) {
                            container.scrollTo({ left: 0, behavior: 'smooth' });
                        } else {
                            container.scrollTo({ left: nextScroll, behavior: 'smooth' });
                        }
                    }, intervalTime);
                }
                
                function stopAutoScroll() {
                    if (intervalId) {
                        clearInterval(intervalId);
                    }
                }
                
                startAutoScroll();
                
                container.addEventListener('mouseenter', stopAutoScroll);
                container.addEventListener('mouseleave', startAutoScroll);
                container.addEventListener('touchstart', stopAutoScroll);
                container.addEventListener('touchend', startAutoScroll);
            })();

            // Cinematic Intro Page Loading Screen Controller
            (function() {
                var intro = document.getElementById('page-intro-overlay');
                if (!intro) return;
                
                // Disable scrolling during intro
                document.body.style.overflow = 'hidden';
                
                setTimeout(function() {
                    intro.classList.add('fade-out');
                    document.body.style.overflow = ''; // Restore scrolling
                }, 2200);
            })();

            // Header Show-on-Scroll Controller (Visible when scrolled down, hidden at the very top)
            (function() {
                var header = document.querySelector('.fahasa-header');
                if (!header) return;
                
                var threshold = 80; // Show header after scrolling down 80px
                
                window.addEventListener('scroll', function() {
                    var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
                    
                    if (scrollTop > threshold) {
                        header.classList.add('header-show');
                    } else {
                        header.classList.remove('header-show');
                    }
                }, { passive: true });
            })();
        })();
    </script>
}
