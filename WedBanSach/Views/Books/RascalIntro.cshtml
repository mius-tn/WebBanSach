@model WedBanSach.Models.Book
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = $"{Model.Title} - Trải Nghiệm Giao Diện Anime Cao Cấp";
    
    var mainImage = Model.BookImages?.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? "/images/default-book.png";
    var otherImages = Model.BookImages?.Where(i => !i.IsMain).Select(i => i.ImageUrl).ToList() ?? new List<string>();
}

@section Styles {
    <!-- SEO Meta Tags & Open Graph -->
    <meta name="description" content="Khám phá câu chuyện tình yêu tuổi trẻ đầy cảm xúc và bí ẩn trong Hội Hội Chứng Tuổi Thanh Xuân (Seishun Buta Yarou) của Hajime Kamoshida." />
    <meta property="og:title" content="@Model.Title - Giao Diện Đặc Biệt" />
    <meta property="og:description" content="Ký ức có thể phai nhòa, nhưng tình cảm sẽ luôn khắc sâu. Trải nghiệm giao diện quảng bá phong cách anime độc đáo." />
    <meta property="og:image" content="https://ao-buta.com/dearfriend/ogp.jpg" />
    <meta property="og:type" content="book" />
    <meta name="twitter:card" content="summary_large_image" />
    
    <!-- Schema.org structure -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Book",
      "name": "@Model.Title",
      "image": "@mainImage",
      "author": {
        "@@type": "Person",
        "name": "Hajime Kamoshida"
      },
      "offers": {
        "@@type": "Offer",
        "price": "@Model.CurrentPrice",
        "priceCurrency": "VND",
        "availability": "https://schema.org/InStock"
      }
    }
    </script>

    <!-- Google Fonts (Cinematic and Japanese typography) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Outfit:wght@400;600;700;800&family=Noto+Serif+JP:wght@600;700&display=swap" rel="stylesheet">
    
    <!-- Custom High-Fidelity Style Sheets representing ao-buta.com/dearfriend/ -->
    <link rel="stylesheet" href="~/css/rascal-intro.css" asp-append-version="true" />

}

