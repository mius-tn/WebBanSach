    <!-- MOBILE MENU HAMBURGER BUTTON -->
    <button class="l-menu" id="mobileMenuBtn" type="button">
        <span class="l-menu__bar"></span>
    </button>

    <!-- MAIN CONTENTS AREA -->
    <main class="l-main" id="top">

        <!-- 1. HERO SECTION -->
        <section class="p-hero">
            <div class="p-hero__kv">
                <div class="p-hero_kv">
                    <div class="p-hero_kv__visual">
                        <figure class="p-hero_kv__visual-img">
                            <img src="https://ao-buta.com/dearfriend/assets/img/main/kv_01.jpg" alt="Rascal Movie Visual Background">
                        </figure>
                        <!-- Floating catch graphic bubble -->
                        <div class="p-hero_kv__visual-catch">
                            <img src="https://ao-buta.com/dearfriend/assets/img/main/catch_01.png" alt="Floating Catchphrase">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Floating Sakura Petals -->
            <div class="particles-container" id="particles"></div>

            <!-- Rotating Menu Button on Desktop -->
            <button class="p-hero__menu-btn js-menu-toggle" type="button">
                <span class="p-hero__menu-btn-content">
                    <span class="p-hero__menu-btn-bar"></span>
                    <span class="p-hero__menu-btn-bar"></span>
                    <span class="p-hero__menu-btn-bar"></span>
                </span>
            </button>

            <!-- Column 2, Row 1 on Desktop (Title & Date) -->
            <div class="p-hero__header scroll-reveal">
                <h1 class="p-hero__logo">
                    <picture>
                        <source srcset="https://ao-buta.com/dearfriend/assets/img/main/logo_sp.png" media="(max-width: 960px)">
                        <img src="https://ao-buta.com/dearfriend/assets/img/main/logo.png" alt="Hội Chứng Tuổi Thanh Xuân Title logo">
                    </picture>
                </h1>

                <div class="p-hero__onscreen">
                    <picture>
                        <source srcset="https://ao-buta.com/dearfriend/assets/img/main/txt_date_sp.png" media="(max-width: 960px)">
                        <img src="https://ao-buta.com/dearfriend/assets/img/main/txt_date_pc.png" alt="2026年10月16日 Phim Hoạt Họa Phát Hành">
                    </picture>
                </div>
            </div>

            <!-- Column 2, Row 2 on Desktop (Banners & Action Buttons) -->
            <div class="p-hero__inner scroll-reveal">
                <!-- Banners -->
               

                <!-- Action Buttons -->
                <div class="p-hero__actions">
                    <a href="#ticket" class="ab-btn ab-btn--pink smooth-scroll-link">ĐẶT MUA SÁCH</a>
                    <a href="#intro" class="ab-btn smooth-scroll-link">ĐỌC THỬ TRUYỆN</a>
                </div>
            </div>
        </section>

        <!-- 2. NEWS SECTION -->
        <section class="p-headline scroll-reveal" id="news">
            <div class="p-headline__container">
                <div class="section-header-title">
                    <h2 class="section-title-en">News</h2>
                    <span class="section-title-vn">Tin Tức Xuất Bản Mới Nhất</span>
                </div>

                <ul class="p-headline__list">
                    <li class="p-headline__list-item">
                        <a href="#ticket" class="p-headline_article">
                            <div class="p-headline_article__date">2026.06.20</div>
                            <div class="p-headline_article__title">Bản Đặc Biệt "Hội Chứng Tuổi Thanh Xuân - Tập 8" tặng kèm PVC Postcard độc quyền chính thức mở bán!</div>
                        </a>
                    </li>
                    <li class="p-headline__list-item">
                        <a href="#ticket" class="p-headline_article">
                            <div class="p-headline_article__date">2026.06.18</div>
                            <div class="p-headline_article__title">Cập nhật quà tặng kèm: Bản giới hạn sở hữu bộ Bookmark ánh kim tuyệt đẹp của thiết kế gốc Satomi Tamura.</div>
                        </a>
                    </li>
                    <li class="p-headline__list-item">
                        <a href="#movie" class="p-headline_article">
                            <div class="p-headline_article__date">2026.06.15</div>
                            <div class="p-headline_article__title">Theater Anime "Hội Hội Chứng Tuổi Thanh Xuân sẽ không mơ về người bạn thân" công bố bản Trailer cuối cùng!</div>
                        </a>
                    </li>
                </ul>

                <a href="#ticket" class="p-headline__more smooth-scroll-link">
                    <div class="p-headline__more-text">Xem Thêm</div>
                </a>
            </div>
        </section>

        <!-- 3. TRAILERS SECTION -->
        <section class="p-movie scroll-reveal" id="movie">
            <div class="p-movie__container">
                <div class="section-header-title">
                    <h2 class="section-title-en">Movie</h2>
                    <span class="section-title-vn">Trailers / Previews Phim Hoạt Họa</span>
                </div>

                <div class="p-movie__slider-wrapper">
                    <div class="p-movie__slider">
                        <!-- Slide 1 -->
                        <div class="p-movie__slide is-active" data-index="0">
                            <div class="p-movie_article__thumb" data-youtube-id="IUS8NwL5o48">
                                <span class="p-movie_article__thumb-img">
                                    <img src="https://img.youtube.com/vi/IUS8NwL5o48/maxresdefault.jpg" alt="Trailer 1 Thumbnail">
                                </span>
                                <div class="play-btn-circle">
                                    <svg viewBox="0 0 100 100" class="play-btn-svg">
                                        <path id="circlePath1" d="M 50, 50 m -35, 0 a 35,35 0 1,1 70,0 a 35,35 0 1,1 -70,0" fill="none" />
                                        <text class="play-btn-text">
                                            <textPath href="#circlePath1" startOffset="0%">Play Movie • Play Movie • Play Movie • </textPath>
                                        </text>
                                    </svg>
                                    <div class="play-btn-icon"></div>
                                </div>
                            </div>
                        </div>
                        <!-- Slide 2 -->
                        <div class="p-movie__slide" data-index="1">
                            <div class="p-movie_article__thumb" data-youtube-id="vW3O-7bHwhs">
                                <span class="p-movie_article__thumb-img">
                                    <img src="https://img.youtube.com/vi/vW3O-7bHwhs/maxresdefault.jpg" alt="Trailer 2 Thumbnail">
                                </span>
                                <div class="play-btn-circle">
                                    <svg viewBox="0 0 100 100" class="play-btn-svg">
                                        <path id="circlePath2" d="M 50, 50 m -35, 0 a 35,35 0 1,1 70,0 a 35,35 0 1,1 -70,0" fill="none" />
                                        <text class="play-btn-text">
                                            <textPath href="#circlePath2" startOffset="0%">Play Movie • Play Movie • Play Movie • </textPath>
                                        </text>
                                    </svg>
                                    <div class="play-btn-icon"></div>
                                </div>
                            </div>
                        </div>
                        <!-- Slide 3 -->
                        <div class="p-movie__slide" data-index="2">
                            <div class="p-movie_article__thumb" data-youtube-id="oD5GW41mCuQ">
                                <span class="p-movie_article__thumb-img">
                                    <img src="https://img.youtube.com/vi/oD5GW41mCuQ/maxresdefault.jpg" alt="Trailer 3 Thumbnail">
                                </span>
                                <div class="play-btn-circle">
                                    <svg viewBox="0 0 100 100" class="play-btn-svg">
                                        <path id="circlePath3" d="M 50, 50 m -35, 0 a 35,35 0 1,1 70,0 a 35,35 0 1,1 -70,0" fill="none" />
                                        <text class="play-btn-text">
                                            <textPath href="#circlePath3" startOffset="0%">Play Movie • Play Movie • Play Movie • </textPath>
                                        </text>
                                    </svg>
                                    <div class="play-btn-icon"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Slide Indicators -->
                    <div class="p-movie__dots">
                        <button type="button" class="p-movie__dot is-active" data-slide="0"></button>
                        <button type="button" class="p-movie__dot" data-slide="1"></button>
                        <button type="button" class="p-movie__dot" data-slide="2"></button>
                    </div>
                </div>
            </div>
        </section>

        <!-- 4. INTRODUCTION SECTION -->
        <section class="p-intro scroll-reveal" id="intro">
            <div class="p-intro__container">
                <div class="section-header-title">
                    <h2 class="section-title-en">Introduction</h2>
                    <span class="section-title-vn">Giới Thiệu Chung Tác Phẩm</span>
                </div>

                <div class="p-intro__inner">
                    <div class="p-intro__lead">
                        Cậu thiếu niên rồi sẽ trưởng thành <span>——</span><br>
                        Câu chuyện kỳ ảo tuổi dậy thì chính thức đi đến hồi kết.
                    </div>
                    <div class="p-intro__text">
                        <p class="p-intro__text-par">
                            Câu chuyện thanh xuân đầy cảm xúc mô tả những rung động tuổi dậy thì<br>
                            thông qua các hiện tượng bí ẩn kỳ ảo mang tên "Hội chứng tuổi dậy thì"<br>
                            được chắp bút bởi tác giả Hajime Kamoshida đã chính thức bước vào chương cuối cùng<span>——</span>.
                        </p>
                        <p class="p-intro__text-par">
                            Hành trình kéo dài xuyên suốt từ thời học sinh cấp ba đến giảng đường đại học của Sakuta,<br>
                            những bí ẩn cuối cùng còn sót lại sẽ dần được hé lộ một cách trọn vẹn và xúc động nhất.
                        </p>
                        <p class="p-intro__text-par">
                            Với sự đồng hành sản xuất của đội ngũ tác giả nguyên tác Hajime Kamoshida, minh họa Keji Mizoguchi,<br>
                            đạo diễn Souichi Masui và thiết kế nhân vật Satomi Tamura bởi CloverWorks,<br>
                            một cái kết đẹp đẽ bối cảnh thành phố biển Fujisawa và Yokohama đầy kỷ niệm sẽ được tái hiện.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Parallax Scrolling image background exactly like ao-buta -->
            <div class="p-intro__visual">
                <figure class="p-intro__visual-img" id="introParallaxImg">
                    <img src="https://ao-buta.com/dearfriend/assets/img/parallax.jpg" alt="Intro Parallax Background">
                </figure>
            </div>
        </section>

        <!-- 5. PROLOGUE SECTION -->
        <section class="p-prologue scroll-reveal" id="prologue">
            <div class="p-prologue__container">
                <div class="section-header-title">
                    <h2 class="section-title-en">Prologue</h2>
                    <span class="section-title-vn">Dẫn Nhập Câu Chuyện</span>
                </div>

                <div class="p-prologue__inner">
                    <div class="p-prologue__lead">
                        <p class="p-prologue__lead-text --cap">
                            "Thực ra, tớ chính là Kirishima Touko"
                        </p>
                        <p class="p-prologue__lead-text">
                            Lời thú nhận chấn động của Mai Sakurajima <span>——</span> nữ ca sĩ mạng nổi tiếng đang ẩn danh <span>——</span><br>
                            đã khiến người hâm mộ xôn xao. Cảnh tượng ấy giống hệt giấc mơ mà Sakuta Azusagawa<br>
                            đã thấy vào đêm Giáng sinh lạnh giá năm ấy.
                        </p>
                        <p class="p-prologue__lead-text">
                            Từ ngày 1 tháng 4, bắt đầu từ lời tuyên bố của Mai,<br>
                            những câu chuyện kì lạ tưởng chừng chỉ có trong mơ lần loạt xảy ra ngoài đời thực.
                        </p>
                        <p class="p-prologue__lead-text">
                            Bài đăng với hashtag "#Yumemiru" (Giấc mơ biến thành hiện thực) trên mạng xã hội đã hoàn toàn biến mất.<br>
                            Giữa thế giới bị ghi đè và nhận thức sai lệch của bản thân, Sakuta bất ngờ nhận được một tin nhắn gửi đến<br>
                            từ chính cậu ở một nhánh thế giới khả năng khác.
                        </p>
                        <p class="p-prologue__lead-text --cap">
                            <span>——</span> Hãy ngăn chặn Kirishima Touko lại<br>
                            <span>——</span> Trước khi thế giới này bị ghi đè hoàn toàn.
                        </p>
                        <p class="p-prologue__lead-text">
                            Để bảo vệ Mai và đưa thế giới trở về bình thường, Sakuta một lần nữa bước vào cuộc hành trình tìm kiếm.<br>
                            Đây là câu chuyện cuối cùng để vượt qua Hội chứng tuổi dậy thì...
                        </p>
                    </div>

                    <!-- Double overlapping character sprites like ao-buta official -->
                    <div class="p-prologue__chara --chara1" id="prologueChara1">
                        <div class="p-prologue__chara-img">
                            <img src="https://ao-buta.com/dearfriend/assets/img/prologue/prologue_img01.jpg" alt="Prologue Illustration 1">
                        </div>
                    </div>
                    <div class="p-prologue__chara --chara2" id="prologueChara2">
                        <div class="p-prologue__chara-img">
