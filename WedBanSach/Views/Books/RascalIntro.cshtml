        <!-- NEW: HORIZONTAL PRODUCT LIST SECTION -->
        <section class="p-horizontal-books scroll-reveal" id="horizontal-books">
            <div class="p-horizontal-books__container">
                <div class="section-header-title">
                    <h2 class="section-title-en">Ticket</h2>
                    <span class="section-title-vn">Vé Đặc Biệt & Trọn Bộ</span>
                </div>
                
                @if (ViewBag.AllRascalBooks != null)
                {
                    foreach (var bookItem in (List<WedBanSach.Models.Book>)ViewBag.AllRascalBooks)
                    {
                        // Chỉ hiển thị duy nhất sản phẩm Combo
                        if (!bookItem.Title.Contains("Combo")) {
                            continue;
                        }

                        var isLimited = bookItem.Title.Contains("Bản Giới Hạn") || bookItem.Title.Contains("Đặc Biệt");
                        var mainImgUrl = bookItem.BookImages?.FirstOrDefault(i => i.IsMain)?.ImageUrl 
                                         ?? bookItem.BookImages?.FirstOrDefault()?.ImageUrl 
                                         ?? "/images/default-book.png";
                        
                        <div class="p-ticket-combo">
                            <div class="p-ticket-combo__subtitle">@bookItem.Title</div>
                            <div class="p-ticket-combo__divider"></div>
                            
                            <div class="p-ticket-combo__content">
                                <div class="p-ticket-combo__visual-wrap">
                                    <div class="p-ticket-combo__visual">
                                        <img src="@mainImgUrl" alt="@bookItem.Title" class="p-ticket-combo__image">
                                    </div>
                                </div>
                                
                                <div class="p-ticket-combo__details">
                                    <dl class="p-ticket-combo__data">
                                        <dt class="p-ticket-combo__data-cap">Ngày Mở Bán</dt>
                                        <dd class="p-ticket-combo__data-text">Đang phát hành rộng rãi</dd>
                                    </dl>
                                    <dl class="p-ticket-combo__data">
                                        <dt class="p-ticket-combo__data-cap">Quà Đính Kèm</dt>
                                        <dd class="p-ticket-combo__data-text">01 Bookmark giấy couche dày mịn theo bìa sách.</dd>
                                    </dl>
                                    <dl class="p-ticket-combo__data">
                                        <dt class="p-ticket-combo__data-cap">Giá Bán</dt>
                                        <dd class="p-ticket-combo__data-text text-danger fw-bold">
                                            @bookItem.CurrentPrice.ToString("#,##0") ₫
                                            @if (bookItem.CurrentPrice < bookItem.OriginalPrice) {
                                                <span class="text-decoration-line-through text-muted small ms-2" style="font-size: 12px; font-weight: normal;">@bookItem.OriginalPrice.ToString("#,##0") ₫</span>
                                            }
                                        </dd>
                                    </dl>
                                    <dl class="p-ticket-combo__data">
                                        <dt class="p-ticket-combo__data-cap">Hình Thức</dt>
                                        <dd class="p-ticket-combo__data-text">Bìa mềm tiêu chuẩn, chất lượng giấy xốp nhập khẩu Phần Lan.</dd>
                                    </dl>
                                    
                                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="p-ticket-combo__form">
                                        <input type="hidden" name="id" value="@bookItem.BookID" />
                                        <button type="submit" class="p-ticket-combo__btn">
                                            <span class="p-ticket-combo__btn-text">ĐẶT MUA SÁCH</span>
                                        </button>
                                    </form>
                                    
                                    <div class="p-ticket-combo__notes">
                                        <div class="p-ticket-combo__notes-cap">Lưu ý mua hàng</div>
                                        <div class="p-ticket-combo__notes-text">
                                            <span class="u-text-indent" data-prefix="※">Trọn bộ combo tiểu thuyết Hội Chứng Tuổi Thanh Xuân (Light Novel) chính hãng từ Nhà xuất bản Kim Đồng.</span>
                                            <span class="u-text-indent" data-prefix="※">Sản phẩm được bảo hành đổi trả miễn phí nếu gặp lỗi từ nhà sản xuất.</span>
                                            <span class="u-text-indent" data-prefix="※">Đóng gói hộp Carton bảo vệ chống móp méo khi vận chuyển.</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </section>

        <!-- 8. TICKETS / BOOK BUY SECTION (Styled like Movie Tickets) -->
        <section class="p-ticket scroll-reveal" id="ticket">
            <div class="p-ticket__container">
                <div class="section-header-title">
                    <h2 class="section-title-en">Ticket & Editions</h2>
                    <span class="section-title-vn">Các Phiên Bản Phát Hành Sách và Giá Bán</span>
                </div>

                <div class="p-ticket__inner">
                    @if (ViewBag.AllRascalBooks != null)
                    {
                        foreach (var bookItem in (List<WedBanSach.Models.Book>)ViewBag.AllRascalBooks)
                        {
                            // Loại bỏ sản phẩm Combo ở khung dưới
                            if (bookItem.Title.Contains("Combo")) {
                                continue;
                            }

                            var isLimited = bookItem.Title.Contains("Bản Giới Hạn") || bookItem.Title.Contains("Đặc Biệt");
                            var mainImgUrl = bookItem.BookImages?.FirstOrDefault(i => i.IsMain)?.ImageUrl 
                                             ?? bookItem.BookImages?.FirstOrDefault()?.ImageUrl 
                                             ?? "/images/default-book.png";
                            
                            <div class="p-ticket_content">
                                <div class="p-ticket_content__header">
                                    <h3 class="p-ticket_content__title">@bookItem.Title</h3>
                                </div>
                                <div class="p-ticket_content__inner">
                                    <div class="p-ticket_content__visual">
                                        @if (isLimited) {
                                            <span class="p-ticket_content__badge">BẢN GIỚI HẠN</span>
                                        }
                                        <figure class="p-ticket_visual__img">
                                            <img src="@mainImgUrl" alt="@bookItem.Title Visual">
                                        </figure>
                                    </div>
                                    <div class="p-ticket_content__outline">
                                        <dl class="p-ticket_content__data">
                                            <dt class="p-ticket_content__data-cap">Ngày Mở Bán</dt>
                                            <dd class="p-ticket_content__data-text">Đang phát hành rộng rãi</dd>
                                        </dl>
                                        <dl class="p-ticket_content__data">
                                            <dt class="p-ticket_content__data-cap">Quà Đính Kèm</dt>
                                            <dd class="p-ticket_content__data-text">
                                                @if (isLimited) {
                                                    @:01 PVC Postcard vẽ tay độc quyền bởi Satomi Tamura + 02 Bookmark ánh kim sắc nét.
                                                } else {
                                                    @:01 Bookmark giấy couche dày mịn theo bìa sách.
                                                }
                                            </dd>
                                        </dl>
                                        <dl class="p-ticket_content__data">
                                            <dt class="p-ticket_content__data-cap">Giá Bán</dt>
                                            <dd class="p-ticket_content__data-text text-danger fw-bold fs-5">
                                                @bookItem.CurrentPrice.ToString("#,##0") ₫
                                                @if(bookItem.CurrentPrice < bookItem.OriginalPrice) {
                                                    <span class="text-muted text-decoration-line-through small ms-2" style="font-size:12px;">@bookItem.OriginalPrice.ToString("#,##0") ₫</span>
                                                }
                                            </dd>
                                        </dl>
                                        <dl class="p-ticket_content__data">
                                            <dt class="p-ticket_content__data-cap">Hình Thức</dt>
                                            <dd class="p-ticket_content__data-text">
                                                @if (isLimited) {
                                                    @:Bìa mềm tay gấp (Đóng gói hộp Carton bảo vệ chống móp méo khi vận chuyển)
                                                } else {
                                                    @:Bìa mềm tiêu chuẩn, chất lượng giấy xốp nhập khẩu Phần Lan.
                                                }
                                            </dd>
                                        </dl>
                                        
                                        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mt-auto">
                                            <input type="hidden" name="id" value="@bookItem.BookID" />
                                            <button type="submit" class="p-ticket_content__btn">
                                                <span class="p-ticket_content__btn-text">ĐẶT MUA SÁCH</span>
                                            </button>
                                        </form>

                                        <dl class="p-ticket_content__note">
                                            <dt class="p-ticket_content__note-cap">Lưu ý mua hàng</dt>
                                            <dd class="p-ticket_content__note-text">
                                                @if (isLimited) {
                                                    <span class="u-text-indent" data-prefix="※">Bản đặc biệt đi kèm đầy đủ bộ Postcard và Bookmark nguyên seal.</span>
                                                    <span class="u-text-indent" data-prefix="※">Số lượng có hạn, chương trình tặng quà sẽ kết thúc khi hết quà tặng kèm.</span>
                                                } else {
                                                    <span class="u-text-indent" data-prefix="※">Bản tiêu chuẩn có bán tại tất cả hệ thống nhà sách toàn quốc.</span>
                                                    <span class="u-text-indent" data-prefix="※">Sản phẩm được bảo hành đổi trả miễn phí nếu gặp lỗi từ nhà sản xuất.</span>
                                                }
                                            </dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </section>

    </main>

