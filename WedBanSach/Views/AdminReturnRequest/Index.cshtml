@model IEnumerable<WedBanSach.Models.ReturnRequest>
@{
    ViewData["Title"] = "Quản lý Đổi/Trả & Hoàn Tiền";
    Layout = "_AdminLayout";
    var stats = ViewBag.Stats as WedBanSach.ViewModels.DashboardStatsViewModel ?? new WedBanSach.ViewModels.DashboardStatsViewModel();
}

@section Styles {
    <link rel="stylesheet" href="~/css/policy.css" asp-append-version="true" />
}

<div class="container-fluid animate-fade-in">
    <div class="mb-4">
        <h3 class="fw-bold"><i class="bi bi-arrow-left-right text-pink"></i> Quản Lý Yêu Cầu Đổi / Trả / Hoàn Tiền</h3>
        <p class="text-muted">Trung tâm phê duyệt đổi mới sản phẩm, bồi hoàn tài chính và quản lý tồn kho lỗi.</p>
    </div>

    <!-- 1. KPI Stats Cards Row -->
    <div class="row g-3 mb-4">
        <!-- Total Requests -->
        <div class="col-md-3">
            <div class="admin-card-stat p-4 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small uppercase fw-bold">Tổng yêu cầu</span>
                        <h2 class="fw-bold text-dark mt-1 mb-0">@stats.TotalRequests</h2>
                    </div>
                    <div class="bg-pink-light text-pink rounded-circle p-3 fs-3 d-flex align-items-center justify-content-center" style="width: 55px; height: 55px; background-color: var(--primary-pastel-bg) !important;">
                        <i class="bi bi-folder-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending -->
        <div class="col-md-3">
            <div class="admin-card-stat p-4 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small uppercase fw-bold">Chờ xử lý</span>
                        <h2 class="fw-bold text-warning mt-1 mb-0">@stats.PendingRequests</h2>
                    </div>
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3 fs-3 d-flex align-items-center justify-content-center" style="width: 55px; height: 55px;">
                        <i class="bi bi-clock-history"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Completed Refund -->
        <div class="col-md-3">
            <div class="admin-card-stat p-4 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small uppercase fw-bold">Tiền đã hoàn</span>
                        <h2 class="fw-bold text-success mt-1 mb-0">@stats.TotalRefunded.ToString("N0") <span class="fs-6">đ</span></h2>
                    </div>
                    <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 fs-3 d-flex align-items-center justify-content-center" style="width: 55px; height: 55px;">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Warranties pending -->
        <div class="col-md-3">
            <div class="admin-card-stat p-4 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small uppercase fw-bold">Bảo hành chờ duyệt</span>
                        <h2 class="fw-bold text-danger mt-1 mb-0">@stats.PendingWarrantyRequests</h2>
                    </div>
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-3 fs-3 d-flex align-items-center justify-content-center" style="width: 55px; height: 55px;">
                        <i class="bi bi-shield-exclamation"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Chart & Monthly Stats Panel -->
    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-4">
                <h5 class="fw-bold text-dark mb-4"><i class="bi bi-graph-up-arrow"></i> Biểu đồ hoàn tiền & khối lượng yêu cầu đổi trả (6 tháng qua)</h5>
                <div style="height: 300px; position: relative;">
                    <canvas id="refundsChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-pie-chart"></i> Phân tích trạng thái</h5>
                    <div class="list-group list-group-flush small">
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span><i class="bi bi-circle-fill text-warning me-2"></i> Chờ thẩm định (Pending)</span>
                            <span class="badge bg-warning text-dark">@stats.PendingRequests</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span><i class="bi bi-circle-fill text-primary me-2"></i> Đã duyệt nhận hàng (Approved)</span>
                            <span class="badge bg-primary">@stats.ApprovedRequests</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span><i class="bi bi-circle-fill text-success me-2"></i> Hoàn thành (Completed)</span>
                            <span class="badge bg-success">@stats.CompletedRequests</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span><i class="bi bi-circle-fill text-danger me-2"></i> Từ chối (Rejected)</span>
                            <span class="badge bg-danger">@stats.RejectedRequests</span>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top text-center">
                    <a asp-controller="AdminWarranty" class="btn btn-sm btn-outline-primary w-100 py-2">
                        <i class="bi bi-shield-shaded"></i> Xem danh sách bảo hành phụ kiện
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Return Requests Table Panel -->
    <div class="card shadow-sm border-0 rounded-3 mb-5">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold m-0 text-dark"><i class="bi bi-list-task"></i> Bảng Danh Sách Yêu Cầu Đổi Trả</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle" id="returnRequestsTable">
                    <thead class="table-light">
                        <tr>
                            <th>Mã RQ</th>
                            <th>Đơn hàng</th>
                            <th>Khách hàng</th>
                            <th>Hình thức</th>
                            <th>Mặt hàng lỗi</th>
                            <th>Ngày gửi</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var typeText = item.RequestType switch
                            {
                                "Exchange" => "Đổi hàng",
                                "Return" => "Trả hàng hoàn tiền",
                                "Refund" => "Hoàn tiền",
                                "Warranty" => "Bảo hành",
                                _ => item.RequestType
                            };

                            var statusText = item.Status switch
                            {
                                "Pending" => "Chờ xử lý",
                                "Approved" => "Đã duyệt/Thu hồi",
                                "Rejected" => "Bị từ chối",
                                "Completed" => "Đã xong",
                                _ => item.Status
                            };

                            var statusBadge = item.Status switch
                            {
                                "Pending" => "bg-warning text-dark",
                                "Approved" => "bg-primary",
                                "Rejected" => "bg-danger",
                                "Completed" => "bg-success",
                                _ => "bg-secondary"
                            };

                            <tr>
                                <td class="fw-bold text-primary">#RQ-@item.Id</td>
                                <td><strong>#@item.OrderId</strong></td>
                                <td>
                                    <div class="fw-bold">@item.Customer.FullName</div>
                                    <small class="text-muted text-xs">@item.Customer.Phone</small>
                                </td>
                                <td><span class="fw-bold text-dark">@typeText</span></td>
                                <td>
                                    <div class="text-truncate" style="max-width: 200px;" title="@(item.Book?.Title ?? "N/A")">
                                        @(item.Book?.Title ?? "N/A")
                                    </div>
                                    <small class="text-muted">Số lượng: @item.Quantity</small>
                                </td>
                                <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge @statusBadge rounded-pill px-3 py-2 small">@statusText</span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> Thẩm định
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // DataTable init
            $('#returnRequestsTable').DataTable({
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/vi.json'
                },
                order: [[5, 'desc']] // sort by Date descending
            });

            // Chart.js init
            const ctx = document.getElementById('refundsChart').getContext('2d');
            
            // Render labels & amounts from ViewModel
            const labels = @Html.Raw(Json.Serialize(stats.MonthlyLabels));
            const refundAmounts = @Html.Raw(Json.Serialize(stats.MonthlyRefundAmounts));
            const requestCounts = @Html.Raw(Json.Serialize(stats.MonthlyRequestCounts));

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            type: 'line',
                            label: 'Số lượng yêu cầu',
                            data: requestCounts,
                            borderColor: '#e91e63',
                            borderWidth: 2,
                            fill: false,
                            yAxisID: 'y1'
                        },
                        {
                            type: 'bar',
                            label: 'Tiền hoàn lại (VND)',
                            data: refundAmounts,
                            backgroundColor: 'rgba(40, 167, 69, 0.25)',
                            borderColor: '#28a745',
                            borderWidth: 1,
                            yAxisID: 'y'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            title: {
                                display: true,
                                text: 'Tiền hoàn (VND)'
                            },
                            ticks: {
                                callback: function(value) {
                                    return new Intl.NumberFormat('vi-VN').format(value) + ' đ';
                                }
                            }
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            title: {
                                display: true,
                                text: 'Số yêu cầu'
                            },
                            grid: {
                                drawOnChartArea: false // prevent overlapping grid lines
                            }
                        }
                    }
                }
            });
        });
    </script>
}
