@page
@model WedBanSach.Pages.ContactModel
@{
    ViewData["Title"] = "Liên Hệ";
}

<!-- BREADCRUMB (giống cấu trúc trên web) -->
<div class="bg-light py-2 mb-3">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item active fw-bold text-uppercase" aria-current="page">Liên Hệ</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container pb-5 mt-4">
    <div class="row bg-white p-4 rounded-3 shadow-sm border-soft pt-5 pb-5">
        <div class="col-md-6 mb-4">
            <h3 class="fw-bold mb-4 text-uppercase">Thông tin liên hệ</h3>
            <p class="text-muted mb-4">
                Nếu bạn có bất kỳ câu hỏi nào về dịch vụ, sản phẩm hay cần hỗ trợ, xin vui lòng điền vào biểu mẫu bên cạnh. Đội ngũ của chúng tôi luôn sẵn sàng hỗ trợ bạn.
            </p>

            <div class="d-flex mb-3">
                <div class="text-pink fs-4 me-3"><i class="bi bi-geo-alt-fill"></i></div>
                <div>
                    <h6 class="fw-bold mb-1">Địa chỉ</h6>
                    <p class="text-muted small mb-0">Lầu 5, 387-389 Hai Bà Trưng, Quận 3, TP HCM</p>
                </div>
            </div>

            <div class="d-flex mb-3">
                <div class="text-pink fs-4 me-3"><i class="bi bi-telephone-fill"></i></div>
                <div>
                    <h6 class="fw-bold mb-1">Điện thoại</h6>
                    <p class="text-muted small mb-0">1900 636467</p>
                </div>
            </div>

            <div class="d-flex mb-3">
                <div class="text-pink fs-4 me-3"><i class="bi bi-envelope-fill"></i></div>
                <div>
                    <h6 class="fw-bold mb-1">Email</h6>
                    <p class="text-muted small mb-0">info@fahasa.com</p>
                </div>
            </div>
            
            <div class="mt-4">
                <h6 class="fw-bold mb-3">Mạng xã hội</h6>
                <div class="d-flex gap-2">
                    <a href="#" class="btn btn-outline-secondary rounded-circle"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="btn btn-outline-secondary rounded-circle"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="btn btn-outline-secondary rounded-circle"><i class="bi bi-youtube"></i></a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <h3 class="fw-bold mb-4 text-uppercase">Gửi tin nhắn</h3>
            
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-check-circle-fill flex-shrink-0 me-2"></i>
                    <div>
                        @Model.SuccessMessage
                    </div>
                </div>
            }

            <form method="post" class="needs-validation">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Input.FullName" class="form-label fw-bold small"></label>
                        <input asp-for="Input.FullName" class="form-control bg-light" placeholder="Nhập họ và tên..." />
                        <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.Email" class="form-label fw-bold small"></label>
                        <input asp-for="Input.Email" class="form-control bg-light" placeholder="Nhập địa chỉ email..." />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Input.Subject" class="form-label fw-bold small"></label>
                        <input asp-for="Input.Subject" class="form-control bg-light" placeholder="Chủ đề cần hỗ trợ..." />
                        <span asp-validation-for="Input.Subject" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Input.Message" class="form-label fw-bold small"></label>
                        <textarea asp-for="Input.Message" class="form-control bg-light" rows="5" placeholder="Viết nội dung tin nhắn ở đây..."></textarea>
                        <span asp-validation-for="Input.Message" class="text-danger small"></span>
                    </div>

                    <div class="col-12 mt-4 text-end">
                        <button type="submit" class="btn btn-danger px-5 rounded-pill fw-bold">Gửi Tin Nhắn <i class="bi bi-send ms-2"></i></button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Thêm thư viện validation của ASP.NET Core -->
    <partial name="_ValidationScriptsPartial" />
}
